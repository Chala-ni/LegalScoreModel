# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values

# Google AI Configuration (Teacher Model for Training Data Generation)
# Get your API key from: https://makersuite.google.com/app/apikey
# Copy this file to .env and add your real API key there
GOOGLE_API_KEY="AIzaSyCmfbhhH_NNXsoBBiCxEgyh03GtibXqUoo"
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=5000

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
DEBUG=true

# Tesseract OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGE=sin+eng
OCR_DPI=300

# Database Configuration (Optional)
DATABASE_URL=sqlite:///./legal_score.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs/

# Model Paths
BASE_MODEL_PATH=models/base
FINE_TUNED_MODEL_PATH=models/fine_tuned/adapter_model
